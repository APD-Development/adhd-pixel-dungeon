        "visual_findings": [
          {
            "scope": "Excess Charge normal and normal-bottom",
            "result": "pass",
            "observation": "All three rank values 0.67, 1.34 and 2.01 visibly appear with shielding per effective level of its imbued wand. Temporary wand-level bonuses, nearest-whole-point rounding, stronger existing Barrier preservation and amounts not adding together are readable. The whole ordinary description fits in both captures, including its final line and Show calculations button."
          },
          {
            "scope": "Excess Charge expanded and bottom",
            "result": "pass",
            "observation": "Expanded view visibly gives current rank 2/3 and the existing effective-wand formula with the 1.34 factor. Its longer body scrolls; the bottom capture shows the stronger-Barrier rule and final usual time and charges line above the Hide calculations button. Cropped text at the opposite scroll edge is expected; no unreachable ending was observed."
          },
          {
            "scope": "Counter Ability normal and normal-bottom",
            "result": "pass",
            "observation": "Rank +2 visibly reads 0.75 charges. Other ranks visibly retain 0.38, 1.13 and 1.5. No 0.77 or expanded-calculation prose appears. All four rank paragraphs and their final lines fit inside the ordinary window in both captures."
          },
          {
            "scope": "Trap on, restarted and Off",
            "result": "pass",
            "observation": "The Continue when traps are revealed checkbox and its complete description are now visible in all three settings frames. On and restarted show a filled checked box; reopened Off shows an empty unchecked box. Adjacent sections are partly outside the scrolled viewport, as expected; the reviewed setting is not clipped."
          },
          {
            "scope": "Trap runtime",
            "result": "pass",
            "observation": "The live gameplay capture visibly shows Caustic Ooze feedback and its green effect below the hero. Actual runtime assertions and the distinct process IDs are recorded separately from this visual observation."
          },
          {
            "scope": "Four wall geometry frames",
            "result": "pass",
            "observation": "The searched-face and retained-state images show the continuous wall face; corner and door variants show their distinct gap/door geometry without an unexpected overlay bridging it. No visible rendering break was observed in these four selected frames; the original native wall assertions also passed."
          },
          {
            "scope": "Five automatic-inventory frames",
            "result": "pass",
            "observation": "Backpack, Magical Holster, Potion Bandolier and Velvet Pouch headings, item grids, numeric indicators and selected tabs remain visible. The final Backpack frame also renders its reordered items. No unexpected window clipping or overlapping controls was observed."
          },
          {
            "scope": "Six bounded regression frames",
            "result": "pass",
            "observation": "Hidden Twin Upgrades sword top/bottom retain readable explanation and action buttons; Magic Missile wand top/bottom retain the visible +5 title, damage text and buttons. Feint normal/bottom remain readable, including four-turn Haste/Weakness/Vulnerable values and the existing 0.75 weapon-ability refund. These are sampled existing-panel regressions, not new gameplay features."
          }
        ],
        "native_assertion_support": "The passing QoL case asserts actual talent text, final-line reachability and unchanged hero HP/time; visual review independently checked the pixels in the listed captures.",
